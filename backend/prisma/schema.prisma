generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Market {
  us
  kr
}

enum RunStatus {
  running
  success
  partial // 일부 스킬 실패
  failed
}

enum SkillStatus {
  success
  failed
  skipped
}

enum Condition {
  clear
  cloudy
  rain
}

model Run {
  id            String        @id @default(uuid())
  kind          String // market_daily | evening_refresh | core_weekly | symbols_weekly
  market        Market        @default(us)
  status        RunStatus     @default(running)
  startedAt     DateTime      @default(now()) @db.Timestamptz
  finishedAt    DateTime?     @db.Timestamptz
  error         String?
  claudeCostUsd Decimal?      @db.Decimal(10, 4)
  skillOutputs  SkillOutput[]

  @@index([kind, startedAt])
  @@map("runs")
}

// 스킬 원본 출력은 여기에 통째로 둔다 (절대 규칙 9)
model SkillOutput {
  id         String      @id @default(uuid())
  runId      String
  run        Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  skillId    String
  status     SkillStatus
  rawJson    Json?
  rawMd      String?
  error      String?
  durationMs Int?
  createdAt  DateTime    @default(now()) @db.Timestamptz

  @@index([runId])
  @@index([skillId, createdAt])
  @@map("skill_outputs")
}

// tradeDate는 원본 데이터의 거래일(뉴욕 기준 장 날짜)이다
model MarketSnapshot {
  id              String     @id @default(uuid())
  market          Market     @default(us)
  tradeDate       DateTime   @db.Date
  runId           String
  marketScore     Float? // market-breadth-analyzer composite_score
  breadthZone     String?
  uptrendRatio    Float? // uptrend-analyzer 전체 상승추세 비율 (0~1)
  uptrendScore    Float?
  uptrendZone     String?
  exposureCeiling Int? // exposure-coach exposure_ceiling_pct
  recommendation  String? // NEW_ENTRY_ALLOWED | REDUCE_ONLY | CASH_PRIORITY
  condition       Condition?
  summaryKo       String?
  // 홈 "왜?"·"다시 맑아지려면" 영역용 (2026-11-23 추가)
  exposureScore      Float? // exposure-coach composite_score. 30 미만 비, 50 미만 흐림
  exposureConfidence String? // HIGH | MEDIUM | LOW
  exposureMissing    String[] // 판정에 빠진 입력 (regime, top_risk, ftd …)
  breadthComponents  Json? // 시장 점수 6개 항목 [{ key, score }]
  uptrendPercentile  Float? // 상승추세 비율의 과거 대비 위치 (0~100)
  uptrendMedian      Float? // 상승추세 비율 과거 중앙값 (0~1)
  // FMP 키로 붙는 판정 입력 (2026-11-23)
  topRiskScore Float? // market-top-detector composite (0~100, 높을수록 고점 위험)
  topRiskZone  String? // Green | Yellow | Orange | Red …
  regime       String? // macro-regime-detector current_regime (contraction, broadening …)
  ftdState     String? // ftd-detector combined_state (CORRECTION, FTD_CONFIRMED, FTD_INVALIDATED …)
  createdAt       DateTime   @default(now()) @db.Timestamptz
  updatedAt       DateTime   @updatedAt @db.Timestamptz

  @@unique([market, tradeDate])
  @@map("market_snapshots")
}

model SectorSnapshot {
  id           String   @id @default(uuid())
  market       Market   @default(us)
  tradeDate    DateTime @db.Date
  runId        String
  sector       String
  rank         Int
  uptrendRatio Float
  trend        String? // Up | Down
  slope        Float?
  status       String? // Normal | Overbought | Oversold
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@unique([market, tradeDate, sector])
  @@map("sector_snapshots")
}

// ── Phase 2: 종목 목록, 내 종목, 일봉 ──────────────────────────────

enum SymbolType {
  stock
  etf
}

// Nasdaq Trader 종목 목록 + 한투 해외주식 마스터 한글명. 주 1회 갱신 (symbols_weekly)
model Symbol {
  symbol    String     @id // 거래소 티커 (BRK.B처럼 점 포함 그대로)
  market    Market     @default(us)
  exchange  String // NASDAQ | NYSE | NYSE American | NYSE Arca | Cboe BZX
  nameEn    String
  nameKo    String? // 한투 마스터에 한글명이 있을 때만
  type      SymbolType
  aliases   String[] // 사용자 별칭 (예: 엔비, 테슬)
  updatedAt DateTime   @updatedAt @db.Timestamptz

  holding   Holding?
  watchItem WatchItem?

  @@index([nameEn])
  @@map("symbols")
}

// 보유 종목. 증권사 계좌 연동 없이 사용자가 직접 입력한다
model Holding {
  symbol      String   @id
  info        Symbol   @relation(fields: [symbol], references: [symbol])
  shares      Float
  avgCost     Float // 평단가 (달러)
  stopPrice   Float? // 손절가
  stopMethod  String? // percent | atr | support | manual
  targetPrice Float?
  note        String?
  openedAt    DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@map("holdings")
}

model WatchItem {
  symbol  String   @id
  info    Symbol   @relation(fields: [symbol], references: [symbol])
  note    String?
  addedAt DateTime @default(now()) @db.Timestamptz

  @@map("watchlist")
}

// 정규장 일봉. date는 뉴욕 장 날짜. 장중 미완성 봉은 저장하지 않는다 (절대 규칙 6)
model PriceBar {
  symbol String
  date   DateTime @db.Date
  open   Float
  high   Float
  low    Float
  close  Float
  volume Float

  @@id([symbol, date])
  @@map("price_bars")
}

// 사용자 설정 한 줄씩 (예: capital = 총 투자금). 계정이 하나뿐인 개인 앱이라 키-값으로 둔다
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("settings")
}

// ── AI 대결: AI 모의 계좌 vs 내 매매 기록 (2026-11-23) ──────────────────
// AI는 규칙(backend/src/ai/strategy.ts)대로 신호를 내고 모의로 사고판다. 주문은 하지 않는다 (절대 규칙 1).

model AiAccount {
  id                String       @id @default(uuid())
  /** 규칙 버전 (v1 추세 추종 스윙, v2 원칙 강화). 같은 자금으로 나란히 돌려 비교한다 */
  ruleVersion       String       @default("v1")
  startCapital      Float
  cash              Float
  active            Boolean      @default(true)
  startedAt         DateTime     @default(now()) @db.Timestamptz
  /** 마지막으로 처리한 장 날짜. 그 다음 봉부터 체결·청산을 본다 */
  lastProcessedDate DateTime?    @db.Date
  signals           AiSignal[]
  positions         AiPosition[]
  equity            AiEquity[]

  @@map("ai_accounts")
}

// 스캐너가 찾은 셋업 하나에 대한 AI의 판단과 계획
model AiSignal {
  id          String     @id @default(uuid())
  accountId   String
  account     AiAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date // 신호가 나온 장 날짜 (그날 종가 기준)
  symbol      String
  side        String // buy | sell
  setups      String[] // breakout_20d, bull_flag, reclaim_ma20, oversold …, sell은 stop | target | ma50 | time
  verdict     String // buy(조건부 매수) | hold(시장 때문에 보류) | watch(셋업 약함) | sell
  status      String // planned | filled | expired | held | watch | skipped | done
  checks      Json // [{ key, label, pass, detail }]
  closePrice  Float
  triggerPrice Float? // 조건부 매수가: 신호 날 고가 + 1센트. 3거래일 안에 넘으면 체결
  stopPrice   Float?
  targetPrice Float?
  shares      Int?
  riskAmount  Float?
  reasonKo    String
  exitPlanKo  String?
  note        String? // 체결 못 한 이유 등
  commentKo   String? // Claude 한 줄 해설 (Phase 4). 판단은 규칙 결과 그대로, 말로 옮기기만
  positionId  String?
  createdAt   DateTime   @default(now()) @db.Timestamptz

  @@unique([accountId, date, symbol, side])
  @@index([accountId, date])
  @@map("ai_signals")
}

model AiPosition {
  id          String    @id @default(uuid())
  accountId   String
  account     AiAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  signalId    String?
  symbol      String
  shares      Int
  entryDate   DateTime  @db.Date
  entryPrice  Float
  stopPrice   Float
  /** v1은 고정 목표가, v2는 목표가 없이 추세 이탈로 판다 */
  targetPrice Float?
  /** v2: +1R을 넘어 손절가를 본전으로 올렸는지 */
  breakeven   Boolean   @default(false)
  status      String // open | closed
  /** 종가 규칙(50일선 이탈·시간 손절)에 걸려 다음 날 시가에 팔 예정이면 그 이유 */
  pendingExit String?
  exitDate    DateTime? @db.Date
  exitPrice   Float?
  exitReason  String? // stop | target | ma50 | time
  pnl         Float?

  @@index([accountId, status])
  @@map("ai_positions")
}

model AiEquity {
  accountId      String
  account        AiAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date           DateTime  @db.Date
  cash           Float
  positionsValue Float
  equity         Float

  @@id([accountId, date])
  @@map("ai_equity")
}

// 내 매매 기록 ("샀음/팔았음"). 기록하면 holdings가 따라 바뀐다
model Trade {
  id          String   @id @default(uuid())
  symbol      String
  side        String // buy | sell
  date        DateTime @db.Date
  price       Float
  shares      Float
  /** 팔았을 때 그 시점 평단가 기준 실현 손익 */
  realizedPnl Float?
  note        String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([date])
  @@map("trades")
}

// 내 계좌 가치 일별 기록 (AI와 같은 날 같은 방식으로 비교하려고)
model MyEquity {
  date        DateTime @id @db.Date
  equity      Float
  marketValue Float
  realizedPnl Float

  @@map("my_equity")
}

// 일정. 지금은 실적 발표만 (FMP 무료 플랜은 경제지표 일정이 막혀 있다). date는 미국 날짜
model CalendarEvent {
  id               String   @id @default(uuid())
  type             String // earnings
  symbol           String
  date             DateTime @db.Date
  epsEstimated     Float?
  revenueEstimated Float?
  updatedAt        DateTime @updatedAt @db.Timestamptz

  @@unique([type, symbol, date])
  @@index([date])
  @@map("calendar_events")
}

// Claude 시장 해설 (Phase 4). 장 날짜마다 한 번. Claude는 계산된 값을 말로 옮기기만 한다 (절대 규칙 2·3·7)
model Commentary {
  id           String   @id @default(uuid())
  market       Market   @default(us)
  tradeDate    DateTime @db.Date
  headline     String
  summary      String[] // 시장 해설 3줄
  why          String[] // 왜 이런 날씨인가 3줄
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float?
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@unique([market, tradeDate])
  @@map("commentaries")
}

// ── Phase 3 종목 소식: 뉴스·공시, 분기 실적, 의원 거래 (2026-11-23) ──────────

// 야후 헤드라인과 SEC 8-K. id는 스킬이 준 값 (rss:… / sec:…). 제목에 종목이 나오는 것만 저장한다
model NewsItem {
  id          String   @id
  symbol      String
  kind        String // headline | sec
  source      String
  title       String
  titleKo     String? // Claude 번역 (Phase 4)
  importance  String? // high | normal (Claude 분류)
  summary     String?
  url         String
  publishedAt DateTime @db.Timestamptz
  tags        String[]
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([symbol, publishedAt])
  @@map("news_items")
}

// SEC XBRL 분기 실적 (trader-analyst). 4분기는 연간 − 3개 분기로 만든 값(derived)
model EarningsFact {
  symbol          String
  periodEnd       DateTime @db.Date
  fiscal          String
  derived         Boolean
  revenue         Float?
  netIncome       Float?
  epsDiluted      Float?
  grossMargin     Float?
  operatingMargin Float?
  netMargin       Float?
  revenueYoy      Float?
  epsYoy          Float?
  form            String?
  filed           DateTime? @db.Date

  @@id([symbol, periodEnd])
  @@map("earnings_facts")
}

// 미국 하원 의원 주식 거래 신고 (PTR). 신고는 거래 뒤 최대 45일 늦게 온다
model CongressDoc {
  docId       String   @id
  member      String
  district    String?
  filed       DateTime @db.Date
  processedAt DateTime @default(now()) @db.Timestamptz
  trades      CongressTrade[]

  @@map("congress_docs")
}

/// 현직 하원 의원 (unitedstates/congress-legislators 공개 데이터). 신고 문서의 지역구(NJ07)로 잇는다
model CongressMember {
  bioguide   String   @id
  name       String
  party      String // Republican | Democrat | Independent
  state      String
  district   Int // 주 전체 단일 선거구는 0
  /// 상임위원회 thomas id (HSAS 등, 소위원회 제외)
  committees String[]
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([state, district])
  @@map("congress_members")
}

model CongressTrade {
  id         String      @id @default(uuid())
  docId      String
  doc        CongressDoc @relation(fields: [docId], references: [docId], onDelete: Cascade)
  ticker     String?
  asset      String
  type       String // P(매수) | S(매도) | S (partial) | E(교환)
  typeName   String
  tradeDate  DateTime?   @db.Date
  amount     String
  amountLow  Int?
  amountHigh Int?
  owner      String?

  @@index([ticker])
  @@map("congress_trades")
}

// ── Phase 7: 저녁 프리마켓 스냅샷 (하루 1회, 기준 시각 표시. 실시간 아님) ──

model PremarketSnapshot {
  id          String   @id @default(uuid())
  symbol      String
  /// 그날 열릴 미국 장 날짜 (뉴욕)
  sessionDate DateTime @db.Date
  takenAt     DateTime @db.Timestamptz
  /// 프리마켓 마지막 체결가와 그 시각
  price       Float
  priceAt     DateTime @db.Timestamptz
  /// 전날 정규장 종가
  prevClose   Float

  @@unique([symbol, sessionDate])
  @@map("premarket_snapshots")
}

// ── Phase 6: 깊게 분석 (버튼을 누를 때만, Claude) ──

/// 종목 리포트 한 번 = 작업 하나. running → success | failed. 입력(스크립트 계산값)과 Claude 출력을 통째로 남긴다
model StockReport {
  id           String    @id @default(uuid())
  symbol       String
  status       String // running | success | failed
  /// Claude에 넘긴 계산값 (지지·저항, 이동평균, 분기 실적 등)
  input        Json
  output       Json?
  error        String?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime  @default(now()) @db.Timestamptz
  finishedAt   DateTime? @db.Timestamptz

  @@index([symbol, createdAt])
  @@map("stock_reports")
}
